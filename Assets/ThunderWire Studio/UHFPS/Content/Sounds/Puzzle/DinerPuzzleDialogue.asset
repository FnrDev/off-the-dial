    - rid: 1152278877500866639
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 0
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: 'another closing shift. '
          NormalText: 
    - rid: 1152278877500866640
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 2.3590693
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: 'Had to turn the music back on first. '
          NormalText: 
    - rid: 1152278877500866641
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 9.284079
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Then the old machine behind the counter started hissing again\u2026 "
          NormalText: 
    - rid: 1152278877500866642
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 5.5552278
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: 'The silence in this place gets too loud after midnight. '
          NormalText: 
    - rid: 1152278877500866643
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 12.784634
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: 'like someone whispering through steam. '
          NormalText: 
    - rid: 1152278877500866644
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 16.13299
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: 'I went to check the cold storage in the back. '
          NormalText: 
    - rid: 1152278877500866645
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 19.17695
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "Before I could leave\u2026 "
          NormalText: 
    - rid: 1152278877500866646
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 21.688217
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: 'The register snapped open on its own. '
          NormalText: 
    - rid: 1152278877500866647
      type: {class: DialogueAsset/DialogueSubtitle, ns: UHFPS.Scriptable, asm: Assembly-CSharp}
      data:
        Time: 24.199484
        Narrator: Radio
        NarratorColor: {r: 1, g: 1, b: 1, a: 1}
        Text:
          GlocText: "...I\u2019m never working nights here again."
          NormalText: 
