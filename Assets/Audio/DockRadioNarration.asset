  Dialogues:
  - DialogueAudio: {fileID: 8300000, guid: e661e434319affd4f94ccf95ebbcfc66, type: 3}
    SubtitleType: 1
    SingleSubtitle:
      Time: 0
      Narrator:
      NarratorColor: {r: 1, g: 1, b: 1, a: 1}
