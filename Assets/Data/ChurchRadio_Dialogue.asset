  m_Name: ChurchRadio_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::UHFPS.Scriptable.DialogueAsset
  Dialogues:
  - DialogueAudio: {fileID: 8300000, guid: c396a7526f1664021858cdde3f43b9e8, type: 3}
    SubtitleType: 1
    SingleSubtitle:
      Time: 0
      Narrator:
