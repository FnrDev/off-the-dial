    - target: {fileID: 8541960315968224901, guid: 471f94be919bb8c4a9b55fab006af519, type: 3}
      propertyPath: PaperText.GlocText
      value: "*If you are reading this, I am already gone.\n\nThey were watching
        the docks. I had to hide it before the tide came in.\n\nThe container by
        the sea holds everything.\n\nThe password is 7491.\n\nDo not write it down.
        Do not say it aloud. Burn this when you are done.\n\n\u2014 E."
      objectReference: {fileID: 0}
    - target: {fileID: 8541960315968224901, guid: 471f94be919bb8c4a9b55fab006af519, type: 3}
      propertyPath: PaperText.NormalText
      value: "If you are reading this, I am already gone.\n\nThey were watching the
        docks. I had to hide it before the tide came in.\n\nThe container by the
        sea holds everything.\n\nThe password is 7491.\n\nDo not write it down. Do
        not say it aloud. Burn this when you are done.\n\n\u2014 E."
      objectReference: {fileID: 0}
